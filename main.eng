// ==============================
// 1. 辞書の定義エリア
// ==============================
let he: 名詞 = "彼";
let she: 名詞 = "彼女";
let play: 動詞 = "プレイする";
let is: be動詞 = "〜である";
let tennis: 名詞 = "テニス";
let happy: 形容詞 = "幸せな状態";

// ==============================
// 2. 文の構築エリア
// ==============================

// 【初心者向け】 「文」として定義（何文型でもOK）
let basic1: 文 = he.play;

// 【中級者向け】 「SV」などの型を厳格に指定（指定した文型に合致しないとエラーになる）
let strict1: SV = he.play;
let strict2: SVO = she.play.tennis;

// 【中級者のエラーテスト】 実際の文はSVCなのに、SVOとして定義しようとした場合
let err_type: SVO = he.is.happy;

// `err_type` のテストを実行すると、「**TypeError: 実際の文型は 'SVC' ですが、変数宣言で 'SVO' が要求されています**」と、
// プログラミングコンパイラならではの非常に分かりやすいエラーメッセージが出るようになっています。ぜひ試してみてください！